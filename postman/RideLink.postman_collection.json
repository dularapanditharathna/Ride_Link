    {
      "name": "Ride Management",
      "item": [
        {
          "name": "Create Ride",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "pm.environment.set('ride_id', j.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{passenger_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n \"pickup\":\"Negombo Station\",\n \"destination\":\"Katunayake Airport\",\n \"serviceArea\":\"Negombo\",\n \"distanceKm\":10.5,\n \"estimatedFare\":1350.00\n}"
            },
            "url": {
              "raw": "{{ride_url}}/api/rides",
              "host": [
                "{{ride_url}}"
              ],
              "path": [
                "api",
                "rides"
              ]
            }
          }
        },
