  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Passenger",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Nimal\",\n  \"lastName\": \"Perera\",\n  \"email\": \"passenger@ridelink.test\",\n  \"password\": \"Password123\",\n  \"phone\": \"0771234567\"\n}"
            },
            "url": {
              "raw": "{{account_url}}/api/auth/register/passenger",
              "host": [
                "{{account_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register",
                "passenger"
              ]
            }
          }
        },
        {
          "name": "Login Passenger",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "pm.environment.set('passenger_token', j.token);",
                  "pm.environment.set('passenger_id', j.accountId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"passenger@ridelink.test\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{account_url}}/api/auth/login",
              "host": [
                "{{account_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
